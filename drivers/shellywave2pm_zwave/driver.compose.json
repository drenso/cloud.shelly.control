                "$extends": "zwaveRestoreStateO1"
              },
              {
                "$extends": "zwaveAutoTimerUnitO1"
              },
              {
                "$extends": "zwaveAutoOffO1"
              },
              {
                "$extends": "zwaveAutoOnO1"
              },
              {
                "$extends": "zwaveContactTypeO1"
              }
            ]
          },
          {
            "type": "group",
            "label": {
              "en": "Device Settings",
              "nl": "Apparaatinstellingen"
            },
            "children": [
              {
                "$extends": "zwavePowerReportOnChangeO1"
              },
              {
                "$extends": "zwaveMinimalTimePowerReportO1"
              }
            ]
          }
        ]
      },
      "2": {
        "name": { "en": "Wave 2PM - O2" },
        "class": "socket",
        "capabilities": [
          "onoff",
          "measure_power",
          "meter_power",
          "button.reset_meter",
          "alarm_heat",
          "alarm_shelly_overcurrent"
        ],
        "settings": [
          {
