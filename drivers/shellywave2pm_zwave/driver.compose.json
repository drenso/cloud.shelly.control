            "children": [
              {
                "$extends": "zwaveRestoreStateO2"
              },
              {
                "$extends": "zwaveAutoTimerUnitO2"
              },
              {
                "$extends": "zwaveAutoOffO2"
              },
              {
                "$extends": "zwaveAutoOnO2"
              },
              {
                "$extends": "zwaveContactTypeO2"
              }
            ]
          },
          {
            "type": "group",
            "label": {
              "en": "Device Settings",
              "nl": "Apparaatinstellingen"
            },
            "children": [
