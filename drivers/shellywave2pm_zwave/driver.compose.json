{
  "$extends": "zwave",
  "name": {
    "en": "Wave 2PM"
  },
  "class": "socket",
  "capabilities": ["button.restart", "hidden.button_pressed", "hidden.input_switch_changed"],
  "zwave": {
    "manufacturerId": 1120,
    "productTypeId": [2],
    "productId": [129],
    "associationGroups": [],
    "associationGroupsMultiChannel": [1],
    "multiChannelNodes": {
      "1": {
        "name": { "en": "Wave 2PM - O1" },
        "class": "socket",
        "capabilities": [
          "onoff",
          "measure_power",
          "meter_power",
          "button.reset_meter",
          "alarm_heat",
          "alarm_shelly_overcurrent"
        ],
        "settings": [
          {
            "type": "group",
            "label": {
              "en": "Switch-Output Settings",
              "nl": "Switch-Output instellingen"
            },
            "children": [
